# ========================================================
# PolyTrack .NET Web API Environment Configuration
# ========================================================

# Server Port (Render, Railway, or Container standard port)
PORT=5030

# PostgreSQL Database Connection
# Standard Connection String:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=PolyTrack;Username=postgres;Password=polytrack1234
# OR Cloud URI Format (Neon, Supabase, Render, Railway):
# DATABASE_URL=postgres://postgres:polytrack1234@localhost:5432/PolyTrack

# JWT Authentication
Jwt__Secret=your-super-secret-key-min-32-characters-long-12345
Jwt__Issuer=PolyTrackAPI
Jwt__Audience=PolyTrackClients
Jwt__ExpirationMinutes=60

# Frontend & CORS Origins (comma-separated for multiple domains)
# Local: http://localhost:3000
# Production: https://your-polytrack-app.vercel.app,https://polytrack.studio
FrontendUrl=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloud S3-Compatible File Storage (Optional - falls back to local disk storage if unset)
# S3_BUCKET_NAME=polytrack-assets
# S3_ACCESS_KEY=your-s3-access-key
# S3_SECRET_KEY=your-s3-secret-key
# S3_SERVICE_URL=https://s3.amazonaws.com
# S3_REGION=us-east-1

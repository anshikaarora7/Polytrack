# ========================================================
# PolyTrack ASP.NET Core Backend Environment Variables
# ========================================================

# ── 1. Database Connection (Required) ──
# Option A: Standard PostgreSQL URI (Neon, Supabase, Railway, Render)
DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/polytrack?sslmode=require

# Option B: Standard Npgsql Connection String
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=PolyTrack;Username=postgres;Password=polytrack1234

# ── 2. JWT Authentication (Required in Production) ──
JWT_SECRET=your-production-super-secret-key-at-least-32-chars-long!
JWT_ISSUER=PolyTrackAPI
JWT_AUDIENCE=PolyTrackClients
JWT_EXPIRATION_MINUTES=60

# ── 3. Frontend & CORS Configuration (Required for Cross-Origin Web App) ──
# Exact URL of your deployed frontend (Vercel / custom domain)
FRONTEND_URL=https://polytrack.vercel.app
# Additional comma-separated allowed origins (supports wildcards like *.vercel.app automatically)
ALLOWED_ORIGINS=https://polytrack.vercel.app,https://studio.yourdomain.com

# ── 4. S3-Compatible Cloud Storage (Cloudflare R2 / AWS S3 / MinIO) ──
# When set, all 3D assets (.blend/.fbx/.glb), version uploads, and task attachments persist to cloud object storage.
# When omitted, the API safely falls back to local disk storage in /app/studio-storage.
S3_BUCKET_NAME=polytrack-studio-storage
S3_ACCESS_KEY=your-r2-or-s3-access-key-id
S3_SECRET_KEY=your-r2-or-s3-secret-access-key
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: leave empty or specify https://s3.<region>.amazonaws.com
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto

# ── 5. Admin Seed Credentials (Optional) ──
ADMIN_EMAIL=admin@polytrack.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin User

# ── 6. Swagger API Documentation (Optional) ──
ENABLE_SWAGGER=true

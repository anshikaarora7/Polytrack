# ========================================================
# PolyTrack Root .gitignore
# ========================================================

# Node & Frontend Build Artifacts
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# Local Environment & Secrets
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
.aspnet-data-protection-keys/
**/.aspnet-data-protection-keys/

# .NET & ASP.NET Core Build Output
**/bin/
**/obj/
**/.vs/
**/.vscode/
**/.nuget/
*.user
*.suo
*.userosscache
*.sln.docstates

# Studio Local Storage, Uploads & Temporary Media
studio-storage/
**/studio-storage/
uploads/
**/uploads/
test_core.blend
downloaded_core.blend

# Logs & Temporary Files
*.log
api.stdout.log
api.stderr.log
prod-out.log
prod-err.log
msbuild.log

# Local Development Binaries & Tools
.tools/

# Archive Files (except the distributed Blender addon)
*.zip
!**/public/downloads/*.zip
Polytrack-Claude.zip
polytrack-claude/

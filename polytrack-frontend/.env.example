# ========================================================
# PolyTrack Web Frontend Environment Variables
# ========================================================

# Public URL of the deployed PolyTrack ASP.NET Core Backend API
# Local Development: http://localhost:5030/api
# Production (Render / Railway / Custom): https://your-polytrack-api.onrender.com/api
NEXT_PUBLIC_API_URL=https://your-polytrack-api.onrender.com/api

# Optional: Split Hosting URLs (only needed if landing page is hosted on a separate domain from the Next.js app)
# NEXT_PUBLIC_APP_URL=https://app.polytrack.studio
# NEXT_PUBLIC_LOGIN_URL=https://app.polytrack.studio/login
# NEXT_PUBLIC_DASHBOARD_URL=https://app.polytrack.studio/dashboard
